{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kokolearn-staging",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kokolearn-staging"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "5ed16c50dddf46a6ab942f0333b0da2d"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokolearn-db",
      "database_id": "9173cd4c-14dd-4a12-9bfe-34e444e8acdb"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  
}
