{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kokolearn",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kokolearn"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "398d713b3ffe479d87e12f32064cc2a6"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokolearn-db",
      "database_id": "662b8f30-14e9-42af-9d51-8f352155ffdb",
      "migrations_dir": "drizzle"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kokolearn.org",
      "custom_domain": true
    }
  ]
}
